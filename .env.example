# Copy to .env and use the password assigned to your local database role.
# Spring explicitly imports this properties-compatible file from the project root.
# Do not surround values with shell quotes.
DB_URL=jdbc:postgresql://127.0.0.1:5432/ai_travel_planner
DB_USERNAME=travel_planner
DB_PASSWORD=replace-with-your-local-database-password
TEST_DB_URL=jdbc:postgresql://127.0.0.1:5432/ai_travel_planner_test

# Only needed when starting with the ai profile. Never commit the real key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
